{
  "name": "@openenvx/html-driver",
  "version": "0.3.5",
  "description": "HTML block editor for OpenEnvx flow/website pages",
  "license": "MPL-2.0",
  "type": "module",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/theme.css",
    "dist/sandbox-worker.js"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": {
      "import": "./dist/theme.css",
      "default": "./dist/theme.css"
    }
  },
  "scripts": {
    "build": "rm -rf dist && rolldown -c rolldown.publish.config.ts && node ./build-dts.ts",
    "build:debug": "STUDIO_SOURCEMAP=1 bun run build",
    "prepack": "bun run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "8.0.0",
    "@openenvx/editor-sandbox": "workspace:*",
    "@tabler/icons-react": "^3.44.0",
    "@tiptap/core": "^3.27.3",
    "@tiptap/extension-color": "^3.27.3",
    "@tiptap/extension-font-family": "^3.27.3",
    "@tiptap/extension-text-align": "3.27.4",
    "@tiptap/extension-text-style": "^3.27.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3"
  },
  "peerDependencies": {
    "@openenvx/studio": ">=0.1.3",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@openenvx/studio": "workspace:*",
    "@openenvx/typescript-config": "workspace:*",
    "@typescript/typescript6": "catalog:dev",
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "catalog:testing",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "esbuild": "^0.25.0",
    "lightningcss": "^1.32.0",
    "rolldown": "catalog:dev",
    "rollup": "catalog:dev",
    "rollup-plugin-dts": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": [
    "./dist/index.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openenvx/editor.git",
    "directory": "packages/html-driver"
  },
  "bugs": {
    "url": "https://github.com/openenvx/editor/issues"
  },
  "homepage": "https://github.com/openenvx/editor/tree/main/packages/html-driver"
}
