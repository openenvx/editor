{
  "name": "@xmazu/openenvxee-preview",
  "version": "0.7.17",
  "description": "Layer preview descriptor DSL / Render IR for OpenEnvx",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
