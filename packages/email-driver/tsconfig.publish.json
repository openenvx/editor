{
  "extends": ["./tsconfig.json", "@openenvx/typescript-config/publish.json"],
  "compilerOptions": {
    "paths": {
      "@openenvx/studio": ["../studio/src/index.ts"],
      "@openenvx/studio/shell": ["../studio/src/shell/index.ts"],
      "@openenvx/studio/schema": ["../studio/src/schema/index.ts"],
      "@openenvx/studio/internal": ["../studio/src/workbench-barrel.ts"],
      "@openenvx/html-driver": ["../html-driver/src/index.ts"],
      "@openenvx/html-driver/runtime": ["../html-driver/src/runtime.ts"],
      "@openenvx/studio/plugins/variables": [
        "../studio/src/plugins/variables/index.ts"
      ],
      "@openenvx/studio/plugins/variables/tiptap": [
        "../studio/src/plugins/variables/tiptap/index.ts"
      ],
      "@openenvx/editor-sandbox/host": ["../editor-sandbox/src/host/index.ts"],
      "@openenvx/editor-sandbox/protocol": ["../editor-sandbox/src/protocol/index.ts"]
    }
  },
  "include": ["src", "../typescript-config/css-modules.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
