{
  "name": "@openenvx/canvas-driver",
  "version": "0.2.2",
  "description": "Canvas editor for OpenEnvx absolute layout pages",
  "license": "MPL-2.0",
  "type": "module",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/theme.css",
    "dist/fonts.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./export/node": "./src/export/node/index.ts",
    "./fonts.css": "./src/fonts/fonts.css",
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && tsup --config tsup.publish.config.ts && node ./build-dts.ts && rsync -a --include='*/' --include='*.css' --exclude='*' src/ dist/ && cp src/fonts/fonts.css dist/fonts.css",
    "build:debug": "STUDIO_SOURCEMAP=1 bun run build",
    "prepack": "bun run build",
    "fonts:fetch": "bun --env-file=../../.env ./scripts/fetch-google-fonts-catalog.ts",
    "test": "vitest",
    "bench": "vitest bench --run",
    "check-types": "tsc --noEmit",
    "verify-pack": "bun run build && bun run ./verify-pack.ts"
  },
  "dependencies": {
    "@openenvx/variables": "workspace:*",
    "@tiptap/extension-color": "^3.27.3",
    "@tiptap/extension-font-family": "^3.27.3",
    "@tiptap/extension-text-style": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "konva": "^10.3.0",
    "lucide-react": "1.24.0",
    "react-konva": "^19.2.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@openenvx/studio": "workspace:*",
    "@openenvx/typescript-config": "workspace:*",
    "@typescript/typescript6": "catalog:dev",
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "pdf-lib": "^1.17.1"
  },
  "peerDependencies": {
    "@openenvx/editor-sandbox": ">=0.7.0",
    "@openenvx/studio": ">=0.1.3",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@openenvx/editor-sandbox": {
      "optional": true
    },
    "@napi-rs/canvas": {
      "optional": true
    },
    "pdf-lib": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./fonts.css": "./dist/fonts.css",
      "./theme.css": {
        "import": "./dist/theme.css",
        "default": "./dist/theme.css"
      }
    },
    "sideEffects": [
      "./dist/index.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openenvx/editor.git",
    "directory": "packages/canvas-driver"
  },
  "bugs": {
    "url": "https://github.com/openenvx/editor/issues"
  },
  "homepage": "https://github.com/openenvx/editor/tree/main/packages/canvas-driver"
}
