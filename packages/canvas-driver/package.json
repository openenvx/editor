{
  "name": "@openenvx/canvas-driver",
  "version": "0.1.3",
  "description": "Canvas editor for OpenEnvx absolute layout pages",
  "license": "MPL-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./studio": "./src/studio/index.ts",
    "./runtime": "./src/publish-runtime.ts",
    "./document-export": "./src/export/canvas-document-export-service.ts",
    "./export": "./src/export/browser/index.ts",
    "./export/node": "./src/export/node/index.ts",
    "./export-bytes": "./src/export/bytes-to-data-url.ts",
    "./export-layers": "./src/export-layers.ts",
    "./registry": "./src/plugin/canvas-registry-service.ts",
    "./contributions/layer-preview-renderer-contribution": "./src/contributions/layer-preview-renderer-contribution.ts",
    "./artboard-offset": "./src/artboard-offset.ts",
    "./fit-text-layer-to-content": "./src/fit-text-layer-to-content.ts",
    "./rich-text-layout": "./src/rich-text-layout.ts",
    "./rich-text-typography": "./src/rich-text-typography.ts",
    "./fonts.css": "./src/fonts/fonts.css",
    "./theme.css": "./dist/studio.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && tsup --config tsup.publish.config.ts && node ./build-dts.ts && rsync -a --include='*/' --include='*.css' --exclude='*' src/ dist/ && cp src/fonts/fonts.css dist/fonts.css",
    "build:debug": "STUDIO_SOURCEMAP=1 bun run build",
    "prepack": "bun run build",
    "fonts:fetch": "bun --env-file=../../.env ./scripts/fetch-google-fonts-catalog.ts",
    "test": "vitest",
    "bench": "vitest bench --run",
    "check-types": "tsc --noEmit",
    "verify-pack": "bun run build && bun run ./verify-pack.ts"
  },
  "dependencies": {
    "@openenvx/variables": "workspace:*",
    "@tiptap/extension-color": "^3.27.3",
    "@tiptap/extension-font-family": "^3.27.3",
    "@tiptap/extension-text-style": "^3.27.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "konva": "^10.3.0",
    "lucide-react": "1.24.0",
    "react-konva": "^19.2.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@openenvx/core": "workspace:*",
    "@openenvx/typescript-config": "workspace:*",
    "@typescript/typescript6": "catalog:dev",
    "@openenvx/workbench": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "pdf-lib": "^1.17.1"
  },
  "peerDependencies": {
    "@openenvx/core": ">=0.1.3",
    "@openenvx/editor-sandbox": ">=0.7.0",
    "@openenvx/studio": ">=0.1.3",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@openenvx/editor-sandbox": {
      "optional": true
    },
    "@napi-rs/canvas": {
      "optional": true
    },
    "pdf-lib": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./studio": {
        "types": "./dist/studio.d.ts",
        "import": "./dist/studio.js",
        "default": "./dist/studio.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "import": "./dist/runtime.js",
        "default": "./dist/runtime.js"
      },
      "./document-export": {
        "import": "./dist/export/canvas-document-export-service.js",
        "default": "./dist/export/canvas-document-export-service.js"
      },
      "./export": {
        "import": "./dist/export/browser/index.js",
        "default": "./dist/export/browser/index.js"
      },
      "./export/node": {
        "import": "./dist/export/node/index.js",
        "default": "./dist/export/node/index.js"
      },
      "./export-bytes": {
        "import": "./dist/export/bytes-to-data-url.js",
        "default": "./dist/export/bytes-to-data-url.js"
      },
      "./export-layers": {
        "import": "./dist/export-layers.js",
        "default": "./dist/export-layers.js"
      },
      "./registry": {
        "import": "./dist/plugin/canvas-registry-service.js",
        "default": "./dist/plugin/canvas-registry-service.js"
      },
      "./contributions/layer-preview-renderer-contribution": {
        "import": "./dist/contributions/layer-preview-renderer-contribution.js",
        "default": "./dist/contributions/layer-preview-renderer-contribution.js"
      },
      "./artboard-offset": {
        "import": "./dist/artboard-offset.js",
        "default": "./dist/artboard-offset.js"
      },
      "./fit-text-layer-to-content": {
        "import": "./dist/fit-text-layer-to-content.js",
        "default": "./dist/fit-text-layer-to-content.js"
      },
      "./rich-text-layout": {
        "import": "./dist/rich-text-layout.js",
        "default": "./dist/rich-text-layout.js"
      },
      "./rich-text-typography": {
        "import": "./dist/rich-text-typography.js",
        "default": "./dist/rich-text-typography.js"
      },
      "./fonts.css": "./dist/fonts.css",
      "./theme.css": {
        "import": "./dist/studio.css",
        "default": "./dist/studio.css"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openenvx/editor.git",
    "directory": "packages/canvas-driver"
  },
  "bugs": {
    "url": "https://github.com/openenvx/editor/issues"
  },
  "homepage": "https://github.com/openenvx/editor/tree/main/packages/canvas-driver"
}
