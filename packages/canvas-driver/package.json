{
  "name": "@openenvx/canvas-driver",
  "version": "0.3.7",
  "description": "Canvas editor for OpenEnvx absolute layout pages",
  "license": "MPL-2.0",
  "type": "module",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/theme.css",
    "dist/fonts.css"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./export/node": "./src/export/node/index.ts",
    "./fonts.css": {
      "development": "./src/fonts/fonts.css",
      "import": "./dist/fonts.css",
      "default": "./dist/fonts.css"
    },
    "./theme.css": {
      "import": "./dist/theme.css",
      "default": "./dist/theme.css"
    }
  },
  "scripts": {
    "build": "rm -rf dist && rolldown -c rolldown.publish.config.ts && node ./build-dts.ts && cp src/fonts/fonts.css dist/fonts.css",
    "build:debug": "STUDIO_SOURCEMAP=1 bun run build",
    "prepack": "bun run build",
    "fonts:fetch": "bun --env-file=../../.env ./scripts/fetch-google-fonts-catalog.ts",
    "test": "vitest",
    "bench": "vitest bench --run",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "@tiptap/extension-color": "^3.27.3",
    "@tiptap/extension-font-family": "^3.27.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "konva": "^10.3.0",
    "react-konva": "^19.2.5",
    "react-reconciler": "0.33.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@openenvx/studio": "workspace:*",
    "@openenvx/typescript-config": "workspace:*",
    "@typescript/typescript6": "catalog:dev",
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "lightningcss": "^1.32.0",
    "rolldown": "catalog:dev",
    "rollup": "catalog:dev",
    "rollup-plugin-dts": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "pdf-lib": "^1.17.1"
  },
  "peerDependencies": {
    "@openenvx/editor-sandbox": ">=0.7.0",
    "@openenvx/studio": ">=0.1.3",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@openenvx/editor-sandbox": {
      "optional": true
    },
    "@napi-rs/canvas": {
      "optional": true
    },
    "pdf-lib": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": [
    "./dist/index.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openenvx/editor.git",
    "directory": "packages/canvas-driver"
  },
  "bugs": {
    "url": "https://github.com/openenvx/editor/issues"
  },
  "homepage": "https://github.com/openenvx/editor/tree/main/packages/canvas-driver"
}
