{
  "name": "@openenvx/widget-sdk",
  "version": "0.1.0",
  "description": "OpenEnvx widget authoring SDK — defineExtension, props, Preact→RenderNode expand, Vite isolate bundling",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src/vite",
    "src/openenvx.d.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": "./src/vite/bundle-widget-sources-plugin.ts",
    "./vite/client": "./src/vite/client.d.ts",
    "./openenvx": "./src/openenvx.d.ts"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "bun run build",
    "test": "vitest",
    "check-types": "tsc --noEmit",
    "openenvx-manifest": "bun run ./src/cli/openenvx-manifest.ts"
  },
  "bin": {
    "openenvx-manifest": "./src/cli/openenvx-manifest.ts"
  },
  "dependencies": {
    "@openenvx/elements": "workspace:*",
    "@xmazu/openenvxee-protocol": "workspace:*",
    "preact": "^10.26.5"
  },
  "devDependencies": {
    "@openenvx/typescript-config": "workspace:*",
    "esbuild": "^0.25.0",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "8.1.3",
    "vitest": "catalog:testing"
  },
  "peerDependencies": {
    "esbuild": "^0.25.0",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.openenvx.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openenvx/openenvx.git",
    "directory": "packages/widget-sdk"
  },
  "bugs": {
    "url": "https://github.com/openenvx/openenvx/issues"
  },
  "homepage": "https://openenvx.dev"
}
