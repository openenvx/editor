{
  "name": "@xmazu/openenvxee-extensions",
  "version": "0.7.18",
  "description": "OpenEnvx sandbox extension author SDK — protocol wire types, element vocabulary, defineExtension, Vite packaging",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src/vite",
    "src/openenvx.d.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "bun": "./dist/protocol/index.js",
      "import": "./dist/protocol/index.js",
      "default": "./dist/protocol/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "bun": "./dist/canvas.js",
      "import": "./dist/canvas.js",
      "default": "./dist/canvas.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "bun": "./dist/html.js",
      "import": "./dist/html.js",
      "default": "./dist/html.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "bun": "./dist/panel.js",
      "import": "./dist/panel.js",
      "default": "./dist/panel.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "bun": "./dist/jsx-runtime.js",
      "import": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "bun": "./dist/jsx-dev-runtime.js",
      "import": "./dist/jsx-dev-runtime.js",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./vite": "./src/vite/bundle-widget-sources-plugin.ts",
    "./vite/client": "./src/vite/client.d.ts",
    "./openenvx": "./src/openenvx.d.ts"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "bun run build",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "openenvx-manifest": "bun run ./src/cli/openenvx-manifest.ts"
  },
  "bin": {
    "openenvx-manifest": "./src/cli/openenvx-manifest.ts"
  },
  "dependencies": {
    "preact": "^10.26.5"
  },
  "devDependencies": {
    "@openenvx/typescript-config": "workspace:*",
    "esbuild": "^0.28.2",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "8.2.2",
    "vitest": "catalog:testing"
  },
  "peerDependencies": {
    "esbuild": "^0.28.2",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xmazu/openenvxee-editor.git",
    "directory": "packages/extensions"
  },
  "bugs": {
    "url": "https://github.com/xmazu/openenvxee-editor/issues"
  },
  "homepage": "https://openenvx.dev"
}
