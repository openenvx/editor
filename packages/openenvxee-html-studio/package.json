{
  "name": "@xmazu/openenvxee-html-studio",
  "version": "0.7.15",
  "description": "OpenEnvx HTML Studio — curated host surface with workbench and HTML block editor bundled for product apps",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/openenvxee-html-studio/src/index.js",
  "module": "./dist/openenvxee-html-studio/src/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/openenvxee-html-studio/src/index.js",
      "import": "./dist/openenvxee-html-studio/src/index.js",
      "default": "./dist/openenvxee-html-studio/src/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "bun": "./dist/openenvxee-html-studio/src/runtime.js",
      "import": "./dist/openenvxee-html-studio/src/runtime.js",
      "default": "./dist/openenvxee-html-studio/src/runtime.js"
    },
    "./theme.css": {
      "import": "./dist/theme/tokens.css",
      "default": "./dist/theme/tokens.css"
    }
  },
  "scripts": {
    "build": "bun run ./build.ts && bun run ./build-dts.ts && bun run ./copy-dist-assets.ts",
    "build:debug": "STUDIO_SOURCEMAP=1 bun run build",
    "prepack": "bun run build",
    "test": "vitest run --passWithNoTests",
    "publish:debug": "bun run ./publish-debug.ts",
    "check-types": "tsc --noEmit"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "8.0.0",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-switch": "1.3.3",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-tooltip": "1.2.12",
    "@tanstack/react-virtual": "^3.13.12",
    "@tiptap/extension-color": "^3.27.3",
    "@tiptap/extension-font-family": "^3.27.3",
    "@tiptap/extension-text-align": "3.27.4",
    "@tiptap/extension-text-style": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "i18next": "^26.3.4",
    "lucide-react": "1.24.0",
    "quickjs-emscripten": "0.32.0",
    "react-colorful": "^5.7.0",
    "react-i18next": "^17.0.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@openenvx/core": "workspace:*",
    "@openenvx/headless": "workspace:*",
    "@openenvx/html": "workspace:*",
    "@openenvx/html-studio": "workspace:*",
    "@openenvx/typescript-config": "workspace:*",
    "@openenvx/workbench": "workspace:*",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@xmazu/openenvxee-preview": "workspace:*",
    "@xmazu/openenvxee-protocol": "workspace:*",
    "@xmazu/openenvxee-schema": "workspace:*",
    "esbuild": "^0.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rollup": "^4.52.0",
    "rollup-plugin-dts": "^6.2.1",
    "typescript": "catalog:dev",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xmazu/openenvxee-editor.git",
    "directory": "packages/openenvxee-html-studio"
  },
  "bugs": {
    "url": "https://github.com/xmazu/openenvxee-editor/issues"
  },
  "homepage": "https://github.com/xmazu/openenvxee-editor#readme"
}
