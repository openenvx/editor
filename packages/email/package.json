{
  "name": "@openenvx/email",
  "version": "0.1.0",
  "description": "OpenEnvx email editor — drop-in React component with bundled workbench UI",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "bun": "./dist/runtime.js",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./theme.css": {
      "import": "./dist/index.css",
      "default": "./dist/index.css"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup && bun run ./build-dts.ts && bun run ./copy-dist-assets.ts",
    "build:debug": "STUDIO_SOURCEMAP=1 bun run build",
    "prepack": "bun run build",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-tooltip": "1.2.12",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@tiptap/extension-color": "^3.27.3",
    "@tiptap/extension-font-family": "^3.27.3",
    "@tiptap/extension-text-align": "3.27.4",
    "@tiptap/extension-text-style": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "i18next": "^26.3.4",
    "lucide-react": "1.24.0",
    "react-colorful": "^5.7.0",
    "react-i18next": "^17.0.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@openenvx/core": "workspace:*",
    "@openenvx/driver-email": "workspace:*",
    "@openenvx/typescript-config": "workspace:*",
    "@openenvx/workbench": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@xmazu/openenvxee-extensions": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rollup": "^4.52.0",
    "rollup-plugin-dts": "^6.2.1",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xmazu/openenvxee-editor.git",
    "directory": "packages/email"
  }
}
