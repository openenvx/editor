{
  "extends": "@openenvx/typescript-config/base.json",
  "include": ["src", "../typescript-config/css-modules.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@openenvx/core": ["../core/src/index.ts"],
      "@openenvx/core/react": ["../core/src/react/workbench-context.tsx"],
      "@openenvx/core/schema": ["../core/src/schema/index.ts"],
      "@openenvx/core/preview": ["../core/src/preview/index.ts"],
      "@openenvx/html": ["../html/src/index.ts"],
      "@openenvx/html/runtime": ["../html/src/runtime.ts"],
      "@openenvx/driver-email": ["../driver-email/src/index.ts"],
      "@openenvx/driver-email/runtime": ["../driver-email/src/runtime.ts"],
      "@openenvx/workbench": ["../workbench/src/index.ts"]
    }
  }
}
