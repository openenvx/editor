{
  "name": "@openenvx/schema",
  "version": "0.1.11",
  "description": "Canonical Scene JSON schema for OpenEnvx",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "scene.schema.json"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./scene.schema.json": "./scene.schema.json"
  },
  "scripts": {
    "generate:json-schema": "bun run src/generate-json-schema.ts",
    "build": "bun run generate:json-schema && tsup",
    "prepack": "bun run build",
    "test": "vitest"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@openenvx/typescript-config": "workspace:*",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.openenvx.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openenvx/openenvx.git",
    "directory": "packages/schema"
  },
  "bugs": {
    "url": "https://github.com/openenvx/openenvx/issues"
  },
  "homepage": "https://openenvx.dev"
}
