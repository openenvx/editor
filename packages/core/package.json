{
  "name": "@openenvx/core",
  "version": "0.1.4",
  "description": "OpenEnvx foundation - scene model, plugins, commands, workbench controller",
  "license": "MPL-2.0",
  "type": "module",
  "files": [
    "dist",
    "scene.schema.json"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/scene.schema.json": "./scene.schema.json",
    "./preview": "./src/preview/index.ts",
    "./react": "./src/react/workbench-context.tsx"
  },
  "scripts": {
    "generate:json-schema": "bun run src/schema/generate-json-schema.ts",
    "build": "tsup && node ./build-dts.ts",
    "prepack": "bun run build",
    "test": "vitest",
    "bench": "vitest bench --run",
    "check-types": "tsc --noEmit",
    "verify-pack": "bun run build && bun run ./verify-pack.ts"
  },
  "dependencies": {
    "uqr": "^0.1.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openenvx/typescript-config": "workspace:*",
    "@typescript/typescript6": "catalog:dev",
    "@types/react": "^19.2.3",
    "react": "19.2.7",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./schema": {
        "types": "./dist/schema/index.d.ts",
        "import": "./dist/schema/index.js",
        "default": "./dist/schema/index.js"
      },
      "./schema/scene.schema.json": "./scene.schema.json",
      "./preview": {
        "types": "./dist/preview/index.d.ts",
        "import": "./dist/preview/index.js",
        "default": "./dist/preview/index.js"
      },
      "./react": {
        "types": "./dist/react/workbench-context.d.ts",
        "import": "./dist/react/workbench-context.js",
        "default": "./dist/react/workbench-context.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openenvx/editor.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/openenvx/editor/issues"
  },
  "homepage": "https://github.com/openenvx/editor/tree/main/packages/core"
}
