{
  "name": "@openenvx/studio",
  "version": "0.5.4",
  "description": "OpenEnvx Studio — workbench UI, canvas, canvas-pro, and agent bundled for host apps",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./fonts.css": "./src/fonts.css"
  },
  "scripts": {
    "build": "tsup && bun run ./build-dts.ts && bun run ./copy-dist-assets.ts",
    "prepack": "bun run build",
    "test": "vitest run --passWithNoTests",
    "publish:local": "bun run build && bun publish --registry http://localhost:8787",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.0",
    "@dnd-kit/core": "6.3.1",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-switch": "1.3.3",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-tooltip": "1.2.12",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "ai": "^6.0.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "i18next": "^26.3.4",
    "konva": "^10.3.0",
    "lucide-react": "1.23.0",
    "react-colorful": "^5.7.0",
    "react-i18next": "^17.0.8",
    "react-konva": "^19.2.5",
    "zod": "4.4.3",
    "quickjs-emscripten": "0.32.0"
  },
  "devDependencies": {
    "@openenvx/agent": "workspace:*",
    "@openenvx/canvas": "workspace:*",
    "@openenvx/core": "workspace:*",
    "@openenvx/headless": "workspace:*",
    "@openenvx/preview": "workspace:*",
    "@openenvx/schema": "workspace:*",
    "@openenvx/typescript-config": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@openenvx/canvas-pro": "workspace:*",
    "@openenvx/workbench": "workspace:*",
    "esbuild": "^0.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rollup": "^4.52.0",
    "rollup-plugin-dts": "^6.2.1",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.openenvx.com",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./theme.css": {
        "import": "./dist/theme/tokens.css",
        "default": "./dist/theme/tokens.css"
      },
      "./fonts.css": {
        "import": "./dist/fonts/fonts.css",
        "default": "./dist/fonts/fonts.css"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xmazu/workbench.git",
    "directory": "packages/studio"
  },
  "bugs": {
    "url": "https://github.com/xmazu/workbench/issues"
  },
  "homepage": "https://github.com/xmazu/workbench#readme"
}
