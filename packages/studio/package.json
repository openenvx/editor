{
  "name": "@openenvx/studio",
  "version": "0.2.0",
  "description": "OpenEnvx editor studio - workbench shell and headless runtime",
  "license": "MPL-2.0",
  "type": "module",
  "files": [
    "dist",
    "scene.schema.json"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme/tokens.css",
    "./core": "./src/core/index.ts",
    "./schema": "./src/core/schema/index.ts",
    "./schema/scene.schema.json": "./scene.schema.json",
    "./preview": "./src/core/preview/index.ts",
    "./react": "./src/core/react/workbench-context.tsx",
    "./internal": "./src/workbench-barrel.ts"
  },
  "scripts": {
    "generate:json-schema": "bun run src/core/schema/generate-json-schema.ts",
    "build": "rm -rf dist && tsup --config tsup.core.config.ts && tsup --config tsup.shell.config.ts && node ./build-dts.ts",
    "build:debug": "STUDIO_SOURCEMAP=1 bun run build",
    "prepack": "bun run build",
    "test": "vitest run",
    "bench": "vitest bench --run src/core",
    "check-types": "tsc --noEmit",
    "verify-pack": "bun run build && bun run ./verify-pack.ts"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.css",
    "**/*.css"
  ],
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-tooltip": "1.2.12",
    "@tanstack/react-virtual": "^3.13.12",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "i18next": "^26.3.4",
    "lucide-react": "1.23.0",
    "react-colorful": "^5.7.0",
    "react-i18next": "^17.0.8",
    "uqr": "^0.1.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openenvx/typescript-config": "workspace:*",
    "@typescript/typescript6": "catalog:dev",
    "@vitejs/plugin-react": "6.0.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1.",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "bun": "./dist/index.js",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./theme.css": {
        "import": "./dist/index.css",
        "default": "./dist/index.css"
      },
      "./core": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core/index.js",
        "default": "./dist/core/index.js"
      },
      "./schema": {
        "types": "./dist/core/schema/index.d.ts",
        "import": "./dist/core/schema/index.js",
        "default": "./dist/core/schema/index.js"
      },
      "./schema/scene.schema.json": "./scene.schema.json",
      "./preview": {
        "types": "./dist/core/preview/index.d.ts",
        "import": "./dist/core/preview/index.js",
        "default": "./dist/core/preview/index.js"
      },
      "./react": {
        "types": "./dist/core/react/workbench-context.d.ts",
        "import": "./dist/core/react/workbench-context.js",
        "default": "./dist/core/react/workbench-context.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openenvx/editor.git",
    "directory": "packages/studio"
  },
  "bugs": {
    "url": "https://github.com/openenvx/editor/issues"
  },
  "homepage": "https://github.com/openenvx/editor/tree/main/packages/studio"
}
