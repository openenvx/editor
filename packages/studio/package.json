{
  "name": "@openenvx/studio",
  "version": "0.1.3",
  "description": "OpenEnvx workbench shell - host surface for composable editor products",
  "license": "MPL-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": {
      "import": "./dist/index.css",
      "default": "./dist/index.css"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node ./build-dts.ts",
    "build:debug": "STUDIO_SOURCEMAP=1 bun run build",
    "prepack": "bun run build",
    "test": "vitest run --passWithNoTests",
    "check-types": "tsc --noEmit",
    "verify-pack": "bun run build && bun run ./verify-pack.ts"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.css",
    "**/*.css"
  ],
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@openenvx/editor-sandbox": "workspace:*",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-switch": "1.3.3",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-tooltip": "1.2.12",
    "@tanstack/react-virtual": "^3.14.12",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "i18next": "^26.3.4",
    "lucide-react": "1.24.0",
    "react-colorful": "^5.7.0",
    "react-i18next": "^17.0.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@openenvx/core": "workspace:*",
    "@openenvx/typescript-config": "workspace:*",
    "@typescript/typescript6": "catalog:dev",
    "@openenvx/workbench": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
  "peerDependencies": {
    "@openenvx/core": ">=0.1.3",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openenvx/editor.git",
    "directory": "packages/studio"
  },
  "bugs": {
    "url": "https://github.com/openenvx/editor/issues"
  },
  "homepage": "https://github.com/openenvx/editor/tree/main/packages/studio"
}
