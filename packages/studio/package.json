{
  "name": "@openenvx/studio",
  "version": "0.3.4",
  "description": "OpenEnvx editor studio - workbench shell and headless runtime",
  "license": "MPL-2.0",
  "type": "module",
  "files": [
    "dist",
    "scene.schema.json"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": {
      "development": "./src/theme/tokens.css",
      "import": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./core": {
      "development": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./schema": {
      "development": "./src/core/schema/index.ts",
      "types": "./dist/core/schema/index.d.ts",
      "import": "./dist/core/schema/index.js",
      "default": "./dist/core/schema/index.js"
    },
    "./schema/scene.schema.json": "./scene.schema.json",
    "./preview": {
      "development": "./src/core/preview/index.ts",
      "types": "./dist/core/preview/index.d.ts",
      "import": "./dist/core/preview/index.js",
      "default": "./dist/core/preview/index.js"
    },
    "./react": {
      "development": "./src/core/react/workbench-context.tsx",
      "types": "./dist/core/react/workbench-context.d.ts",
      "import": "./dist/core/react/workbench-context.js",
      "default": "./dist/core/react/workbench-context.js"
    },
    "./internal": "./src/workbench-barrel.ts",
    "./plugins": "./src/plugins/index.ts",
    "./plugins/variables": "./src/plugins/variables/index.ts",
    "./plugins/variables/tiptap": "./src/plugins/variables/tiptap/index.ts",
    "./plugins/version-history": "./src/plugins/version-history/index.ts"
  },
  "scripts": {
    "generate:json-schema": "bun run src/core/schema/generate-json-schema.ts",
    "build": "rm -rf dist && rolldown -c rolldown.core.publish.config.ts && rolldown -c rolldown.shell.config.ts && node ./build-dts.ts",
    "build:debug": "STUDIO_SOURCEMAP=1 bun run build",
    "prepack": "bun run build",
    "test": "vitest run",
    "bench": "vitest bench --run src/core",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.smoke.json",
    "smoke-next-consumer": "bun ./smoke-next-consumer.ts"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.css",
    "**/*.css"
  ],
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-tooltip": "1.2.12",
    "@tanstack/react-virtual": "^3.13.12",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "i18next": "^26.3.4",
    "lucide-react": "1.23.0",
    "react-colorful": "^5.7.0",
    "react-i18next": "^17.0.8",
    "uqr": "^0.1.3",
    "zod": "4.4.3",
    "@tiptap/core": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openenvx/typescript-config": "workspace:*",
    "@typescript/typescript6": "catalog:dev",
    "@vitejs/plugin-react": "6.0.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1.",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "lightningcss": "^1.32.0",
    "rolldown": "catalog:dev",
    "rollup": "catalog:dev",
    "rollup-plugin-dts": "catalog:dev",
    "@types/node": "^22.10.5",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openenvx/editor.git",
    "directory": "packages/studio"
  },
  "bugs": {
    "url": "https://github.com/openenvx/editor/issues"
  },
  "homepage": "https://github.com/openenvx/editor/tree/main/packages/studio"
}
