{
  "extends": "@openenvx/typescript-config/base.json",
  "include": ["src", "../typescript-config/css-modules.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**"],
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@openenvx/core": ["../core/src/index.ts"],
      "@openenvx/headless": ["../headless/src/index.ts"],
      "@openenvx/headless/react": ["../headless/src/react/workbench-context.tsx"],
      "@xmazu/openenvxee-schema": ["../schema/src/index.ts"],
      "@xmazu/openenvxee-preview": ["../preview/src/index.ts"],
      "@openenvx/canvas": ["../canvas/src/index.ts"],
      "@openenvx/canvas-studio": ["../canvas-studio/src/index.ts"],
      "@openenvx/agent": ["../agent/src/index.ts"],
      "@openenvx/workbench": ["../workbench/src/index.ts"],
      "@openenvx/canvas-pro": ["../canvas-pro/src/index.ts"]
    }
  }
}
