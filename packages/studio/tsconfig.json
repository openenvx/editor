{
  "extends": "@openenvx/typescript-config/base.json",
  "include": ["src", "../typescript-config/css-modules.d.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/schema/generate-json-schema.ts"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "strictNullChecks": true,
    "paths": {
      "#studio": ["./src/index.ts"],
      "#studio/schema": ["./src/schema/index.ts"],
      "#studio/preview": ["./src/preview/index.ts"],
      "#studio/react": ["./src/react/workbench-context.tsx"],
      "#studio/shell": ["./src/shell/index.ts"],
      "#studio/internal": ["./src/workbench-barrel.ts"],
      "#/*": ["./src/*"]
    }
  }
}
