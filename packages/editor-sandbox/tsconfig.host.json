{
  "extends": "@openenvx/typescript-config/base.json",
  "include": ["src/host", "../typescript-config/css-modules.d.ts"],
  "exclude": ["src/host/**/*.test.ts", "src/host/**/*.test.tsx"],
  "compilerOptions": {
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "paths": {
      "@openenvx/editor/host-surface": ["../editor/src/host-surface.ts"],
      "@openenvx/editor/schema": ["../editor/src/schema/index.ts"],
      "@openenvx/editor/preview": ["../editor/src/preview/index.ts"],
      "@openenvx/studio": ["../studio/src/index.ts"],
      "@openenvx/studio/shell": ["../studio/src/shell/index.ts"],
      "@openenvx/studio/schema": ["../studio/src/schema/index.ts"],
      "@openenvx/studio/react": ["../studio/src/react/workbench-context.tsx"],
      "@openenvx/studio/internal": ["../studio/src/workbench-barrel.ts"]
    }
  }
}
