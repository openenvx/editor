{
  "name": "@openenvx/editor-sandbox",
  "version": "0.3.0",
  "description": "OpenEnvx sandbox extension SDK - protocol, Preact author API, QuickJS host runtime",
  "license": "MPL-2.0",
  "type": "module",
  "files": [
    "dist",
    "src/vite"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "bun": "./dist/protocol/index.js",
      "import": "./dist/protocol/index.js",
      "default": "./dist/protocol/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "bun": "./dist/host/index.js",
      "import": "./dist/host/index.js",
      "default": "./dist/host/index.js"
    },
    "./canvas-widget": {
      "types": "./dist/canvas-widget/index.d.ts",
      "bun": "./dist/canvas-widget/index.js",
      "import": "./dist/canvas-widget/index.js",
      "default": "./dist/canvas-widget/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "bun": "./dist/canvas.js",
      "import": "./dist/canvas.js",
      "default": "./dist/canvas.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "bun": "./dist/html.js",
      "import": "./dist/html.js",
      "default": "./dist/html.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "bun": "./dist/panel.js",
      "import": "./dist/panel.js",
      "default": "./dist/panel.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "bun": "./dist/jsx-runtime.js",
      "import": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "bun": "./dist/jsx-dev-runtime.js",
      "import": "./dist/jsx-dev-runtime.js",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./vite": "./src/vite/bundle-widget-sources-plugin.ts",
    "./vite/client": "./src/vite/client.d.ts",
    "./openenvx": {
      "types": "./dist/openenvx.d.ts"
    }
  },
  "scripts": {
    "build": "tsup && rsync -a --include='*/' --include='*.css' --exclude='*' src/host/ dist/host/ && node ./build-dts.ts",
    "prepack": "bun run build",
    "test": "vitest run",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.host.json && tsc --noEmit -p tsconfig.canvas-widget.json",
    "verify-pack": "bun run build && bun run ./verify-pack.ts",
    "openenvx-manifest": "bun run ./src/cli/openenvx-manifest.ts"
  },
  "bin": {
    "openenvx-manifest": "./src/cli/openenvx-manifest.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "preact": "^10.26.5",
    "quickjs-emscripten": "0.32.0"
  },
  "devDependencies": {
    "@openenvx/studio": "workspace:*",
    "@openenvx/typescript-config": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "esbuild": "^0.25.0",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "8.1.3",
    "vitest": "catalog:testing"
  },
  "peerDependencies": {
    "@openenvx/studio": ">=0.1.3",
    "esbuild": "^0.25.0",
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openenvx/editor.git",
    "directory": "packages/editor-sandbox"
  },
  "bugs": {
    "url": "https://github.com/openenvx/editor/issues"
  },
  "homepage": "https://github.com/openenvx/editor/tree/main/packages/editor-sandbox"
}
