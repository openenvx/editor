{
  "name": "@xmazu/openenvxee-elements",
  "version": "0.1.0",
  "description": "OpenEnvx Preact element vocabulary — canvas, HTML, and panel intrinsics",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./canvas": "./src/canvas.ts",
    "./html": "./src/html.ts",
    "./panel": "./src/panel.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "bun run build",
    "test": "vitest run --passWithNoTests",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@xmazu/openenvxee-protocol": "workspace:*",
    "preact": "^10.26.5"
  },
  "devDependencies": {
    "@openenvx/typescript-config": "workspace:*",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.openenvx.com",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./canvas": {
        "types": "./dist/canvas.d.ts",
        "import": "./dist/canvas.js",
        "default": "./dist/canvas.js"
      },
      "./html": {
        "types": "./dist/html.d.ts",
        "import": "./dist/html.js",
        "default": "./dist/html.js"
      },
      "./panel": {
        "types": "./dist/panel.d.ts",
        "import": "./dist/panel.js",
        "default": "./dist/panel.js"
      },
      "./jsx-runtime": {
        "types": "./dist/jsx-runtime.d.ts",
        "import": "./dist/jsx-runtime.js",
        "default": "./dist/jsx-runtime.js"
      },
      "./jsx-dev-runtime": {
        "types": "./dist/jsx-dev-runtime.d.ts",
        "import": "./dist/jsx-dev-runtime.js",
        "default": "./dist/jsx-dev-runtime.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openenvx/openenvx.git",
    "directory": "packages/elements"
  },
  "bugs": {
    "url": "https://github.com/openenvx/openenvx/issues"
  },
  "homepage": "https://openenvx.dev"
}
