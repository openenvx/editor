{
  "name": "@openenvx/workbench",
  "version": "0.1.4",
  "description": "React workbench UI - editor layout, primitives, and descriptor renderers",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme/tokens.css"
  },
  "scripts": {
    "build": "tsup && rsync -a --include='*/' --include='*.css' --exclude='*' src/ dist/",
    "test": "vitest",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
