    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
