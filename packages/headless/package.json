{
  "name": "@openenvx/headless",
  "version": "0.1.11",
  "description": "Headless OpenEnvx controller - subscribe to UI state without a UI framework",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "development": "./src/react/workbench-context.tsx",
      "types": "./dist/react/workbench-context.d.ts",
      "import": "./src/react/workbench-context.tsx",
      "default": "./src/react/workbench-context.tsx"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest"
  },
  "dependencies": {
    "@openenvx/core": "workspace:*",
    "@openenvx/preview": "workspace:*",
    "@openenvx/schema": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@openenvx/typescript-config": "workspace:*",
    "@types/react": "^19.2.3",
    "react": "19.2.7",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openenvx/openenvx.git",
    "directory": "packages/headless"
  },
  "bugs": {
    "url": "https://github.com/openenvx/openenvx/issues"
  },
  "homepage": "https://openenvx.dev",
  "private": true
}
