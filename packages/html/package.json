{
  "name": "@openenvx/html",
  "version": "0.1.0",
  "description": "HTML block editor for OpenEnvx flow/website pages",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsup",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "8.0.0",
    "@openenvx/core": "workspace:*",
    "@xmazu/openenvxee-extensions": "workspace:*",
    "@tiptap/core": "^3.27.3",
    "@tiptap/extension-color": "^3.27.3",
    "@tiptap/extension-font-family": "^3.27.3",
    "@tiptap/extension-text-align": "3.27.4",
    "@tiptap/extension-text-style": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "lucide-react": "1.24.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@openenvx/typescript-config": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "catalog:testing",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
