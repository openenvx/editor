{
  "name": "@openenv/openenvx",
  "version": "0.0.0",
  "private": true,
  "license": "MPL-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "test": "turbo run test -- --run",
    "bench": "turbo run bench --filter=@openenvx/core --filter=@openenvx/canvas",
    "lint": "turbo run lint",
    "check": "ultracite check && knip",
    "check-types": "turbo run check-types --filter='!./apps/*'",
    "precommit": "bun run check && turbo run check-types --filter='...[HEAD]' --filter='!./apps/*' && turbo run build --filter='...[HEAD]' --filter='!./apps/*'",
    "knip": "knip",
    "fix": "ultracite fix",
    "changelog": "git-cliff --unreleased",
    "verify-pack": "bun run verify-pack:html-studio && bun run verify-pack:email-studio && bun run verify-pack:canvas-studio",
    "verify-pack:html-studio": "bun run build --filter=@openenvx/html-studio && bun packages/html-studio/verify-pack.ts",
    "verify-pack:email-studio": "bun run build --filter=@openenvx/email-studio && bun packages/email-studio/verify-pack.ts",
    "verify-pack:canvas-studio": "bun run build --filter=@openenvx/canvas-studio && bun packages/canvas-studio/verify-pack.ts",
    "dev:playground": "turbo run dev --filter=demo-playground",
    "dev:canvas": "turbo run dev --filter=@openenvxee/canvas-demo",
    "dev:html": "turbo run dev --filter=@openenvxee/html-demo",
    "dev:email": "turbo run dev --filter=@openenvxee/email-demo",
    "dev:email-package": "bun run build --filter=@openenvx/email-studio && turbo run dev --filter=@openenvxee/email-package-demo",
    "dev:canvas-package": "bun run build --filter=@openenvx/canvas-studio && turbo run dev --filter=@openenvxee/canvas-package-demo",
    "dev:html-package": "bun run build --filter=@openenvx/html-studio && turbo run dev --filter=@openenvxee/html-package-demo"
  },
  "devDependencies": {
    "eslint-plugin-github": "6.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "git-cliff": "^2.12.0",
    "husky": "^9.1.7",
    "knip": "^6.26.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.74.0",
    "oxlint-plugin-react-doctor": "^0.7.8",
    "turbo": "^2.10.5",
    "typescript": "catalog:dev",
    "ultracite": "7.9.3"
  },
  "catalogs": {
    "dev": {
      "typescript": "^6.0.3",
      "tsup": "^8.5.0"
    },
    "testing": {
      "vitest": "^4.1.10",
      "@vitest/coverage-v8": "^4.1.10"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.0"
}
