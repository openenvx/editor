{
  "name": "@openenv/openenvx",
  "version": "0.0.0",
  "private": true,
  "license": "MPL-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "test": "turbo run test -- --run",
    "bench": "turbo run bench --filter=@openenvx/studio --filter=@openenvx/canvas-driver",
    "lint": "turbo run lint",
    "check": "ultracite check && knip",
    "check-types": "turbo run check-types --filter='!./apps/*'",
    "precommit": "bun run check && turbo run check-types --filter='...[HEAD]' --filter='!./apps/*' && turbo run build --filter='...[HEAD]' --filter='!./apps/*'",
    "knip": "knip",
    "fix": "ultracite fix",
    "changelog": "git-cliff --unreleased",
    "verify-pack": "bun run verify-pack:studio && bun run verify-pack:canvas && bun run verify-pack:html && bun run verify-pack:email && bun run verify-pack:editor-sandbox",
    "verify-pack:studio": "bun run build --filter=@openenvx/studio && bun packages/studio/verify-pack.ts",
    "verify-pack:canvas": "bun run build --filter=@openenvx/canvas-driver && bun packages/canvas-driver/verify-pack.ts",
    "verify-pack:html": "bun run build --filter=@openenvx/html-driver && bun packages/html-driver/verify-pack.ts",
    "verify-pack:email": "bun run build --filter=@openenvx/email-driver && bun packages/email-driver/verify-pack.ts",
    "verify-pack:editor-sandbox": "bun run build --filter=@openenvx/editor-sandbox && bun packages/editor-sandbox/verify-pack.ts",
    "dev:playground": "turbo run dev --filter=demo-playground",
    "dev:canvas": "turbo run dev --filter=@openenvxee/canvas-demo",
    "dev:html": "turbo run dev --filter=@openenvxee/html-demo",
    "dev:email": "turbo run dev --filter=@openenvxee/email-demo",
    "dev:email-package": "bun run build --filter=@openenvx/studio --filter=@openenvx/email-driver && turbo run dev --filter=@openenvxee/email-package-demo",
    "dev:canvas-package": "bun run build --filter=@openenvx/studio --filter=@openenvx/canvas-driver && turbo run dev --filter=@openenvxee/canvas-package-demo",
    "dev:html-package": "bun run build --filter=@openenvx/studio --filter=@openenvx/html-driver && turbo run dev --filter=@openenvxee/html-package-demo"
  },
  "devDependencies": {
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "git-cliff": "^2.12.0",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "turbo": "^2.10.13",
    "typescript": "catalog:dev",
    "ultracite": "7.12.0"
  },
  "catalogs": {
    "dev": {
      "@typescript/typescript6": "^6.0.2",
      "typescript": "^7.0.2",
      "tsup": "^8.5.0"
    },
    "testing": {
      "vitest": "^4.1.10",
      "@vitest/coverage-v8": "^4.1.10"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.0"
}
