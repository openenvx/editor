{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "customConditions": ["development"],
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@xmazu/openenvxee-plugin-protocol": [
        "../../packages/plugin-protocol/src/index.ts"
      ],
      "@xmazu/openenvxee-plugin-protocol/jsx-runtime": [
        "../../packages/plugin-protocol/src/jsx-runtime.ts"
      ],
      "@xmazu/openenvxee-plugin-protocol/jsx-dev-runtime": [
        "../../packages/plugin-protocol/src/jsx-dev-runtime.ts"
      ]
    }
  },
  "include": ["src", "../../packages/typescript-config/css-modules.d.ts"]
}
