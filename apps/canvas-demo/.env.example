# Base URL for export service. Empty = same-origin `/api/export` (vite proxies to :8788 in dev).
VITE_EXPORT_SERVICE_URL=

# Agent service URL (wrangler dev default port 8789).
VITE_AGENT_SERVICE_URL=http://localhost:8789

# Set to false to disable API export and use local browser driver only.
# VITE_EXPORT_SERVICE=false

# Set to false to hide the agent sidebar panel.
# VITE_AGENT_SERVICE=false
