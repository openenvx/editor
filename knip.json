{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "eslint-plugin-github",
    "eslint-plugin-sonarjs",
    "oxlint-plugin-react-doctor"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "package.json",
        "scripts/**/*.{js,ts,mts}!"
      ],
      "project": [
        "*.{js,ts,mts}",
        "scripts/**/*.{js,ts,mts}"
      ]
    },
    "packages/core": {
      "entry": [
        "src/index.ts!",
        "src/schema/index.ts!",
        "src/preview/index.ts!",
        "src/react/workbench-context.tsx!",
        "src/plugins/scene-plugin.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts"
      ]
    },
    "packages/canvas": {
      "entry": [
        "src/index.ts!",
        "src/export-layers.ts!",
        "src/plugin/canvas-plugin.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts"
      ]
    },
    "packages/extensions": {
      "entry": [
        "src/index.ts!",
        "src/protocol/index.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts"
      ]
    },
    "packages/agent": {
      "entry": [
        "src/index.ts!",
        "src/schemas/index.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts"
      ]
    },
    "packages/workbench": {
      "entry": [
        "src/index.ts!",
        "src/sandbox/quickjs.worker.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "ignoreDependencies": [
        "zod"
      ],
      "ignore": [
        "src/primitives/combobox.tsx"
      ]
    },
    "packages/studio": {
      "entry": [
        "src/index.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@ai-sdk/react",
        "@dnd-kit/core",
        "@radix-ui/react-dropdown-menu",
        "@radix-ui/react-popover",
        "@radix-ui/react-select",
        "@radix-ui/react-slot",
        "@radix-ui/react-switch",
        "@radix-ui/react-tabs",
        "@radix-ui/react-tooltip",
        "@tiptap/pm",
        "@tiptap/react",
        "@tiptap/starter-kit",
        "ai",
        "clsx",
        "cmdk",
        "i18next",
        "konva",
        "lucide-react",
        "quickjs-emscripten",
        "react-colorful",
        "react-i18next",
        "react-konva",
        "zod",
        "@openenvx/canvas",
        "@openenvx/core",
        "@openenvx/workbench"
      ]
    },
    "packages/openenvxee-html-studio": {
      "entry": [
        "src/index.ts!",
        "src/runtime.ts!",
        "build.ts!",
        "build-dts.ts!",
        "copy-dist-assets.ts!",
        "publish-debug.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "build.ts",
        "build-dts.ts",
        "copy-dist-assets.ts",
        "publish-debug.ts"
      ],
      "ignoreDependencies": [
        "@dnd-kit/core",
        "@dnd-kit/sortable",
        "@radix-ui/react-dialog",
        "@radix-ui/react-dropdown-menu",
        "@radix-ui/react-popover",
        "@radix-ui/react-select",
        "@radix-ui/react-slot",
        "@radix-ui/react-switch",
        "@radix-ui/react-tabs",
        "@radix-ui/react-tooltip",
        "@tanstack/react-virtual",
        "@tiptap/extension-color",
        "@tiptap/extension-font-family",
        "@tiptap/extension-text-align",
        "@tiptap/extension-text-style",
        "@tiptap/pm",
        "@tiptap/react",
        "@tiptap/starter-kit",
        "clsx",
        "cmdk",
        "i18next",
        "lucide-react",
        "quickjs-emscripten",
        "react-colorful",
        "react-i18next",
        "zod",
        "@openenvx/core",
        "@openenvx/workbench",
        "@xmazu/openenvxee-extensions"
      ]
    },
    "packages/html": {
      "entry": [
        "src/index.ts!",
        "src/runtime.ts!",
        "src/plugin/html-blocks-plugin.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ]
    },
    "packages/driver-email": {
      "entry": [
        "src/index.ts!",
        "src/runtime.ts!",
        "src/plugin/email-blocks-plugin.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ]
    },
    "packages/email": {
      "entry": [
        "src/index.ts!",
        "src/runtime.ts!",
        "build-dts.ts!",
        "tsup.config.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "build-dts.ts",
        "tsup.config.ts"
      ],
      "ignoreDependencies": [
        "@dnd-kit/core",
        "@dnd-kit/sortable",
        "@dnd-kit/utilities",
        "@radix-ui/react-dialog",
        "@radix-ui/react-dropdown-menu",
        "@radix-ui/react-popover",
        "@radix-ui/react-select",
        "@radix-ui/react-slot",
        "@radix-ui/react-tabs",
        "@radix-ui/react-tooltip",
        "@react-email/components",
        "@react-email/render",
        "@tanstack/react-virtual",
        "@tiptap/extension-color",
        "@tiptap/extension-font-family",
        "@tiptap/extension-text-align",
        "@tiptap/extension-text-style",
        "@tiptap/pm",
        "@tiptap/react",
        "@tiptap/starter-kit",
        "clsx",
        "cmdk",
        "i18next",
        "lucide-react",
        "react-colorful",
        "react-i18next",
        "zod",
        "@xmazu/openenvxee-extensions"
      ]
    },
    "packages/html-studio": {
      "entry": [
        "src/index.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/canvas-studio": {
      "entry": [
        "src/index.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/demo-playground": {
      "entry": [
        "src/router.tsx",
        "src/routes/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}",
        "src/styles.css"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/agent-service": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/canvas-demo": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "openenvx-widget"
      ]
    },
    "apps/html-demo": {
      "entry": [
        "src/main.tsx",
        "src/app.tsx",
        "index.html"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "openenvx-widget"
      ]
    },
    "apps/email-demo": {
      "entry": [
        "src/main.tsx",
        "src/app.tsx",
        "index.html"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/email-package-demo": {
      "entry": [
        "src/main.tsx",
        "src/app.tsx",
        "index.html"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  }
}
