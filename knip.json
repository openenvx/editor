{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": false,
  "ignoreDependencies": [
    "eslint-plugin-github",
    "eslint-plugin-sonarjs",
    "oxlint-plugin-react-doctor",
    "@fontsource/cormorant-garamond",
    "@fontsource/inter",
    "@fontsource/parisienne"
  ],
  "workspaces": {
    ".": {
      "entry": ["package.json"],
      "project": ["*.{js,ts}"]
    },
    "packages/core": {
      "entry": ["src/index.ts!", "src/plugins/scene-plugin.ts!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/headless": {
      "entry": ["src/index.ts!", "src/react/workbench-context.tsx!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/canvas": {
      "entry": [
        "src/index.ts!",
        "src/export-layers.ts!",
        "src/plugin/canvas-basics-plugin.ts!",
        "src/contributions/canvas-shell-contributions.ts!"
      ],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/schema": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/preview": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/driver-image": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "apps/demo-playground": {
      "entry": [
        "src/router.tsx",
        "src/routes/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}",
        "src/styles.css"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
