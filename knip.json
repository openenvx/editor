{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "eslint-plugin-github",
    "eslint-plugin-sonarjs",
    "oxlint-plugin-react-doctor",
    "@fontsource/cormorant-garamond",
    "@fontsource/inter",
    "@fontsource/parisienne"
  ],
  "workspaces": {
    ".": {
      "entry": ["package.json"],
      "project": ["*.{js,ts,mts}"]
    },
    "packages/core": {
      "entry": ["src/index.ts!", "src/plugins/scene-plugin.ts!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/headless": {
      "entry": ["src/index.ts!", "src/react/workbench-context.tsx!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/canvas": {
      "entry": [
        "src/index.ts!",
        "src/export-layers.ts!",
        "src/plugin/canvas-basics-plugin.ts!"
      ],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/schema": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/plugin-protocol": {
      "entry": ["src/index.ts!", "src/jsx-runtime.ts!", "src/jsx-dev-runtime.ts!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/preview": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/agent": {
      "entry": ["src/index.ts!", "src/schemas/index.ts!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/workbench": {
      "entry": ["src/index.ts!", "src/sandbox/quickjs.worker.ts!"],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "ignoreDependencies": ["zod"],
      "ignore": ["src/primitives/combobox.tsx"]
    },
    "packages/studio": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@ai-sdk/react",
        "@dnd-kit/core",
        "@radix-ui/react-dropdown-menu",
        "@radix-ui/react-popover",
        "@radix-ui/react-select",
        "@radix-ui/react-slot",
        "@radix-ui/react-switch",
        "@radix-ui/react-tabs",
        "@radix-ui/react-tooltip",
        "@tiptap/pm",
        "@tiptap/react",
        "@tiptap/starter-kit",
        "ai",
        "clsx",
        "cmdk",
        "i18next",
        "konva",
        "lucide-react",
        "quickjs-emscripten",
        "react-colorful",
        "react-i18next",
        "react-konva",
        "zod",
        "@openenvx/core",
        "@xmazu/openenvxee-preview",
        "@xmazu/openenvxee-schema"
      ]
    },
    "packages/canvas-pro": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/html": {
      "entry": ["src/index.ts!", "src/plugin/html-blocks-plugin.ts!"],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ]
    },
    "packages/html-studio": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/demo-playground": {
      "entry": [
        "src/router.tsx",
        "src/routes/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}",
        "src/styles.css"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/agent-service": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/canvas-demo": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/html-demo": {
      "entry": ["src/main.tsx", "src/app.tsx", "index.html"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
