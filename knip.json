{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["const", "gh"],
  "ignoreIssues": {
    "packages/editor-sandbox/src/host/quickjs-isolate-engine.ts": ["exports"],
    "packages/editor-sandbox/src/host/quickjs-runtime.ts": ["exports"],
    "packages/editor-sandbox/src/host/sandbox-extension-controller.ts": ["exports"],
    "packages/email-driver/src/templates/index.ts": ["exports"],
    "packages/email-driver/src/templates/jsx/index.ts": ["exports"],
    "packages/html-driver/src/editor/floating-pill/index.ts": ["exports", "types"],
    "packages/variables/src/variable-edit-dialog.tsx": ["exports"],
    "packages/workbench/src/primitives/input.tsx": ["exports", "types"],
    "packages/workbench/src/context/workbench-context.tsx": ["types"]
  },
  "ignoreDependencies": [
    "eslint-plugin-github",
    "eslint-plugin-sonarjs",
    "oxlint-plugin-react-doctor",
    "@typescript/typescript6"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "package.json"
      ],
      "project": [
        "*.{js,ts,mts}"
      ]
    },
    "packages/core": {
      "entry": [
        "src/index.ts!",
        "src/schema/index.ts!",
        "src/preview/index.ts!",
        "src/react/workbench-context.tsx!",
        "src/plugins/scene-plugin.ts!",
        "verify-pack.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts",
        "verify-pack.ts"
      ]
    },
    "packages/canvas-driver": {
      "ignoreDependencies": [
        "@openenvx/editor-sandbox"
      ],
      "entry": [
        "src/index.ts!",
        "src/studio/index.ts!",
        "src/publish-runtime.ts!",
        "src/export/browser/index.ts!",
        "src/export/node/index.ts!",
        "src/export-layers.ts!",
        "src/plugin/canvas-plugin.ts!",
        "tsup.publish.config.ts!",
        "build-dts.ts!",
        "verify-pack.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts",
        "tsup.publish.config.ts",
        "build-dts.ts",
        "verify-pack.ts"
      ]
    },
    "packages/editor-sandbox": {
      "entry": [
        "src/index.ts!",
        "src/protocol/index.ts!",
        "src/host/index.ts!",
        "src/host/quickjs.worker.ts!",
        "src/canvas-widget/index.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts"
      ]
    },
    "packages/agent": {
      "entry": [
        "src/index.ts!",
        "src/schemas/index.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts"
      ]
    },
    "packages/variables": {
      "entry": [
        "src/index.ts!",
        "src/tiptap/index.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts"
      ]
    },
    "packages/workbench": {
      "entry": [
        "src/index.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "ignoreDependencies": [
        "zod"
      ],
      "ignore": [
        "src/primitives/combobox.tsx"
      ]
    },
    "packages/studio": {
      "entry": [
        "src/index.ts!",
        "tsup.config.ts!",
        "build-dts.ts!",
        "verify-pack.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "tsup.config.ts",
        "build-dts.ts",
        "verify-pack.ts"
      ],
      "ignoreDependencies": [
        "@dnd-kit/core",
        "@dnd-kit/sortable",
        "@dnd-kit/utilities",
        "@radix-ui/react-dialog",
        "@radix-ui/react-dropdown-menu",
        "@radix-ui/react-popover",
        "@radix-ui/react-select",
        "@radix-ui/react-slot",
        "@radix-ui/react-switch",
        "@radix-ui/react-tabs",
        "@radix-ui/react-tooltip",
        "@tanstack/react-virtual",
        "clsx",
        "cmdk",
        "i18next",
        "lucide-react",
        "react-colorful",
        "react-i18next",
        "zod",
        "@openenvx/core",
        "@openenvx/workbench"
      ]
    },
    "packages/html-driver": {
      "ignoreDependencies": [
        "@openenvx/workbench"
      ],
      "entry": [
        "src/index.ts!",
        "src/runtime.ts!",
        "src/studio/index.ts!",
        "src/publish-runtime.ts!",
        "src/plugin/html-blocks-plugin.ts!",
        "tsup.publish.config.ts!",
        "build-dts.ts!",
        "verify-pack.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "tsup.publish.config.ts",
        "build-dts.ts",
        "verify-pack.ts"
      ]
    },
    "packages/email-driver": {
      "ignoreDependencies": [
        "@openenvx/workbench"
      ],
      "entry": [
        "src/index.ts!",
        "src/runtime.ts!",
        "src/studio/index.ts!",
        "src/publish-runtime.ts!",
        "src/plugin/email-blocks-plugin.ts!",
        "tsup.publish.config.ts!",
        "build-dts.ts!",
        "verify-pack.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "tsup.publish.config.ts",
        "build-dts.ts",
        "verify-pack.ts"
      ]
    },
    "apps/demo-playground": {
      "entry": [
        "src/router.tsx",
        "src/routes/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}",
        "src/styles.css"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/agent-service": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/canvas-demo": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "openenvx-widget"
      ]
    },
    "apps/html-demo": {
      "entry": [
        "src/main.tsx",
        "src/app.tsx",
        "index.html"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "openenvx-widget"
      ]
    },
    "apps/email-demo": {
      "entry": [
        "src/main.tsx",
        "src/app.tsx",
        "index.html"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/email-package-demo": {
      "entry": [
        "src/main.tsx",
        "src/app.tsx",
        "index.html"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  }
}
