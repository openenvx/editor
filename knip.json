{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["const", "gh"],
  "ignoreIssues": {
    "packages/editor-sandbox/src/host/quickjs-isolate-engine.ts": ["exports"],
    "packages/editor-sandbox/src/host/quickjs-runtime.ts": ["exports"],
    "packages/editor-sandbox/src/host/sandbox-extension-controller.ts": ["exports"],
    "packages/email-driver/src/templates/index.ts": ["exports"],
    "packages/email-driver/src/templates/jsx/index.ts": ["exports"],
    "packages/html-driver/src/editor/floating-pill/index.ts": ["exports", "types"],
    "packages/studio/src/ui/primitives/input.tsx": ["exports", "types"],
    "packages/studio/src/context/workbench-context.tsx": ["types"],
    "packages/studio/src/workbench-barrel.ts": ["exports"],
    "packages/studio/src/context/locale-context.tsx": ["exports", "types"],
    "packages/studio/src/context/theme-context.tsx": ["exports", "types"],
    "packages/studio/src/context/theme-definitions.ts": ["exports"],
    "packages/studio/src/hooks/use-workbench-selector.ts": ["exports"],
    "packages/studio/src/i18n/workbench-i18n.ts": ["exports"],
    "packages/studio/src/ui/primitives/sheet.tsx": ["exports"],
    "packages/studio/src/ui/renderers/view-panel-renderer.tsx": ["exports"]
  },
  "ignoreDependencies": [
    "eslint-plugin-github",
    "eslint-plugin-sonarjs",
    "oxlint-plugin-react-doctor",
    "@typescript/typescript6"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "package.json"
      ],
      "project": [
        "*.{js,ts,mts}"
      ]
    },
    "packages/canvas-driver": {
      "ignoreDependencies": [
        "@openenvx/editor-sandbox",
        "react-reconciler"
      ],
      "entry": [
        "src/index.ts!",
        "src/publish.ts!",
        "src/publish-runtime.ts!",
        "src/create-canvas-sandbox-extension-host.ts!",
        "src/plugin/canvas-plugin.ts!",
        "rolldown.publish.config.ts!",
        "css-modules-plugin.ts!",
        "build-dts.ts!",
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts",
        "rolldown.publish.config.ts",
        "css-modules-plugin.ts",
        "build-dts.ts",
      ],
      "ignoreIssues": {
        "src/page-presets.ts": ["duplicates"]
      }
    },
    "packages/editor-sandbox": {
      "entry": [
        "rolldown.config.ts!",
        "css-modules-plugin.ts!",
        "src/index.ts!",
        "src/html.ts!",
        "src/panel.ts!",
        "src/canvas.ts!",
        "src/jsx-runtime.ts!",
        "src/jsx-dev-runtime.ts!",
        "src/elements/index.ts!",
        "src/protocol/index.ts!",
        "src/host/index.ts!",
        "src/host/quickjs.worker.ts!",
        "src/canvas-widget/index.ts!",
        "src/openenvx-ambient.ts!",
        "build-dts.ts!",
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts",
        "rolldown.config.ts",
        "css-modules-plugin.ts",
        "build-dts.ts",
      ],
      "ignoreIssues": {
        "src/canvas-widget/document-node-build.ts": ["exports"]
      }
    },
    "packages/agent": {
      "entry": [
        "src/index.ts!",
        "src/schemas/index.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts"
      ]
    },
    "packages/studio": {
      "entry": [
        "src/index.ts!",
        "src/core/index.ts!",
        "src/core/schema/index.ts!",
        "src/core/preview/index.ts!",
        "src/core/react/workbench-context.tsx!",
        "src/core/plugins/scene-plugin.ts!",
        "src/workbench-barrel.ts!",
        "rolldown.shell.config.ts!",
        "rolldown.core.publish.config.ts!",
        "css-modules-plugin.ts!",
        "build-dts.ts!",
        "smoke-next-consumer.ts!",
        "assert-publish-bundle.ts!",
        "rolldown-react-esm-externals.ts!"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "rolldown.shell.config.ts",
        "rolldown.core.publish.config.ts",
        "css-modules-plugin.ts",
        "build-dts.ts",
        "smoke-next-consumer.ts",
        "assert-publish-bundle.ts",
        "rolldown-react-esm-externals.ts"
      ],
      "ignoreDependencies": [
        "zod"
      ],
      "ignoreIssues": {
        "src/core/schema/**": ["duplicates", "exports"],
        "src/core/scene/**": ["duplicates"],
        "src/core/scene/layer-tree.ts": ["exports"],
        "src/core/scene/scene-store.ts": ["types"],
        "src/core/scene/types.ts": ["types"],
        "src/core/schema/types.ts": ["types"]
      },
      "ignore": [
        "src/ui/primitives/combobox.tsx",
        "src/plugins/version-history/**",
        "src/layout/editor-layout-styles.ts",
        "src/layout/local-storage-workbench-layout-store.ts",
        "src/ui/primitives/confirm-dialog.tsx"
      ]
    },
    "packages/html-driver": {
      "entry": [
        "src/index.ts!",
        "src/runtime.ts!",
        "src/publish.ts!",
        "src/publish-runtime.ts!",
        "src/plugin/html-blocks-plugin.ts!",
        "rolldown.publish.config.ts!",
        "css-modules-plugin.ts!",
        "build-dts.ts!",
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "rolldown.publish.config.ts",
        "css-modules-plugin.ts",
        "build-dts.ts",
      ]
    },
    "packages/email-driver": {
      "entry": [
        "src/index.ts!",
        "src/runtime.ts!",
        "src/publish.ts!",
        "src/publish-runtime.ts!",
        "src/plugin/email-blocks-plugin.ts!",
        "rolldown.publish.config.ts!",
        "css-modules-plugin.ts!",
        "build-dts.ts!",
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "rolldown.publish.config.ts",
        "css-modules-plugin.ts",
        "build-dts.ts",
      ]
    },
    "apps/demo-playground": {
      "entry": [
        "src/router.tsx",
        "src/routes/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}",
        "src/styles.css"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/agent-service": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/canvas-demo": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "openenvx-widget"
      ]
    },
    "apps/html-demo": {
      "entry": [
        "src/main.tsx",
        "src/app.tsx",
        "index.html"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "openenvx-widget"
      ]
    },
    "apps/email-demo": {
      "entry": [
        "src/main.tsx",
        "src/app.tsx",
        "index.html"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/canvas-package-demo": {
      "entry": [
        "src/main.tsx",
        "src/app.tsx",
        "index.html",
        "vite.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "vite.config.ts",
        "../host-react-runtime-vite-aliases.ts"
      ],
      "ignoreDependencies": [
        "react-reconciler",
        "scheduler",
        "use-sync-external-store"
      ]
    },
    "apps/html-package-demo": {
      "entry": [
        "src/main.tsx",
        "src/app.tsx",
        "index.html",
        "vite.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "vite.config.ts",
        "../host-react-runtime-vite-aliases.ts"
      ],
      "ignoreDependencies": [
        "react-reconciler",
        "scheduler",
        "use-sync-external-store"
      ]
    },
    "apps/email-package-demo": {
      "entry": [
        "src/main.tsx",
        "src/app.tsx",
        "index.html",
        "vite.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "vite.config.ts",
        "../host-react-runtime-vite-aliases.ts"
      ],
      "ignoreDependencies": [
        "react-reconciler",
        "scheduler",
        "use-sync-external-store"
      ]
    },
    "apps/canvas-next-demo": {
      "entry": [
        "app/layout.tsx",
        "app/page.tsx",
        "next.config.ts"
      ],
      "project": [
        "app/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "react-reconciler",
        "scheduler",
        "use-sync-external-store"
      ]
    }
  }
}
