{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "eslint-plugin-github",
    "eslint-plugin-sonarjs",
    "oxlint-plugin-react-doctor",
    "@fontsource/cormorant-garamond",
    "@fontsource/inter",
    "@fontsource/parisienne"
  ],
  "workspaces": {
    ".": {
      "entry": ["package.json"],
      "project": ["*.{js,ts}"]
    },
    "packages/core": {
      "entry": ["src/index.ts!", "src/plugins/scene-plugin.ts!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/headless": {
      "entry": ["src/index.ts!", "src/react/workbench-context.tsx!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/canvas": {
      "entry": [
        "src/index.ts!",
        "src/export-layers.ts!",
        "src/plugin/canvas-basics-plugin.ts!"
      ],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/schema": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/preview": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/driver-image": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/agent": {
      "entry": ["src/index.ts!", "src/schemas/index.ts!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/studio": {
      "entry": ["src/index.ts!", "tsup.config.ts", "build-dts.ts"],
      "project": [
        "src/**/*.{ts,tsx}",
        "tsup.config.ts",
        "build-dts.ts",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx"
      ],
      "ignoreDependencies": ["zod"]
    },
    "packages/canvas-pro": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.test.ts"]
    },
    "packages/registry-contract": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/demo-playground": {
      "entry": [
        "src/router.tsx",
        "src/routes/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}",
        "src/styles.css"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/agent-service": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/export-service": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/canvas-demo": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
